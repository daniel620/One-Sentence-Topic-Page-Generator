{% from "components/_cite.html.j2" import cite with context %}
<section class="block live-tracker-block" aria-label="Live status">
  {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
  {% if section.summary %}<p class="summary">{{ section.summary }}</p>{% endif %}
  <div class="live-strip">
    {% for item in section.items %}
    <div class="cell">
      <div class="label">{{ item.label }}</div>
      <div class="value">{{ item.value }}</div>
      {% if item.detail %}<div class="detail">{{ item.detail }}</div>{% endif %}
      {{ cite(item) }}
    </div>
    {% endfor %}
  </div>
</section>
