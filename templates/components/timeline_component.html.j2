<section class="card">
  {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
  {% if section.summary %}<p class="muted" style="margin-top: 0;">{{ section.summary }}</p>{% endif %}
  <ol>
    {% for item in section.items %}
    {% if item.label and item.value %}
    <li>
      <strong>{{ item.label }} — {{ item.value }}</strong>
      {% if item.detail %}<div class="muted">{{ item.detail }}</div>{% endif %}
    </li>
    {% endif %}
    {% endfor %}
  </ol>
</section>
