<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.headline %}{{ page.headline }}{% else %}Hot Event Topic Page{% endif %}</title>
  <style>
    :root {
      --bg: #0b1220;
      --surface: #121d33;
      --surface-soft: #1a2842;
      --text: #e8eefc;
      --muted: #a6b3cf;
      --accent: #62a7ff;
      --warning: #ffb347;
      --border: #273756;
      --radius: 14px;
      --shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
      --font: "Inter", "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: radial-gradient(circle at 10% 10%, #162443, var(--bg) 45%);
      color: var(--text);
      font-family: var(--font);
      line-height: 1.55;
    }
    .page { max-width: 1080px; margin: 0 auto; padding: 28px 18px 36px; }
    .card {
      background: linear-gradient(180deg, var(--surface), var(--surface-soft));
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px;
      margin-bottom: 16px;
    }
    .hero h1 { margin: 0 0 8px; font-size: clamp(1.7rem, 3vw, 2.5rem); }
    .hero p { margin: 0; color: var(--muted); font-size: 1.04rem; }
    .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 12px; }
    .pill {
      border: 1px solid var(--border);
      background: rgba(98, 167, 255, 0.08);
      border-radius: 999px;
      padding: 5px 12px;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: capitalize;
    }
    .pill.warning { color: #201300; background: var(--warning); border-color: transparent; font-weight: 700; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .kpi {
      background: rgba(98, 167, 255, 0.08);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
    }
    .kpi .label {
      color: var(--muted);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 6px;
    }
    .kpi .value { font-size: 0.98rem; font-weight: 600; }
    .muted { color: var(--muted); }
    h2 { margin: 0 0 10px; font-size: 1.16rem; }
    h3 { margin: 0 0 6px; font-size: 1rem; }
    ul, ol { margin: 0; padding-left: 1rem; }
    li + li { margin-top: 8px; }
    .source a { color: var(--accent); text-decoration: none; font-weight: 600; }
    .source .meta { color: var(--muted); font-size: 0.88rem; }
    footer { color: var(--muted); text-align: right; font-size: 0.84rem; margin-top: 20px; }
    @media (max-width: 820px) {
      .grid, .grid-3 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="card hero">
      {% if page.urgency_label %}
      <div class="row">
        <span class="pill warning">{{ page.urgency_label }}</span>
      </div>
      {% endif %}
      {% if page.headline %}<h1>{{ page.headline }}</h1>{% endif %}
      {% if page.summary %}<p>{{ page.summary }}</p>{% endif %}
      <div class="row">
        {% if page.status %}<span class="pill">Status: {{ page.status.value | replace("_", " ") }}</span>{% endif %}
        {% if page.confidence %}<span class="pill">Confidence: {{ page.confidence.value }}</span>{% endif %}
        {% if page.event_type %}<span class="pill">Type: {{ page.event_type.value | replace("_", " ") }}</span>{% endif %}
        {% if page.layout_style %}<span class="pill">Layout: {{ page.layout_style.value | replace("_", " ") }}</span>{% endif %}
      </div>
    </section>

    {% if page.sections %}
      {% for section in page.sections %}
        {% set template_name = component_template_by_type.get(section.component_type) %}
        {% if template_name %}
          {% include template_name %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if page.evidence_points %}
    <section class="card">
      <h2>Evidence-backed facts</h2>
      <ol>
        {% for point in page.evidence_points %}
        {% if point.claim and point.source_url %}
        <li class="source">
          <strong>{{ point.claim }}</strong>
          {% if point.value %}<span class="muted"> — {{ point.value }}</span>{% endif %}
          <div class="meta">
            {% if point.source_title %}
            <a href="{{ point.source_url }}" target="_blank" rel="noopener noreferrer">{{ point.source_title }}</a>
            {% else %}
            <a href="{{ point.source_url }}" target="_blank" rel="noopener noreferrer">{{ point.source_url }}</a>
            {% endif %}
          </div>
          {% if point.snippet %}<div class="muted">{{ point.snippet }}</div>{% endif %}
        </li>
        {% endif %}
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    <footer>{% if generated_at %}Generated at {{ generated_at }}{% endif %}</footer>
  </main>
</body>
</html>
