{# Alert hero — disaster pages. Leads with the urgency chip + safety framing. #}
<header class="hero hero-alert">
  <div class="dateline">
    <span class="eyebrow"><span class="dot"></span>{{ page.urgency_label or "Developing" }}</span>
    {% if page.as_of_label %}<span>{{ page.as_of_label }}</span>{% endif %}
  </div>
  <h1>{{ page.headline }}</h1>
  {% if page.deck %}<p class="deck">{{ page.deck }}</p>{% endif %}
  {% if page.summary %}
    {% for paragraph in page.summary | split_sep("\n") %}
      {% if paragraph %}<p class="lede">{{ paragraph }}</p>{% endif %}
    {% endfor %}
  {% endif %}
</header>
