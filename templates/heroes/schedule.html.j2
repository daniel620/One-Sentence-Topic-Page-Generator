{# Schedule hero — for upcoming events. "Kickoff in X days" feel. #}
<header class="hero hero-schedule">
  <div class="dateline">
    {% if page.urgency_label %}<span class="eyebrow"><span class="dot"></span>{{ page.urgency_label }}</span>{% endif %}
    {% if page.as_of_label %}<span>{{ page.as_of_label }}</span>{% endif %}
  </div>
  <h1>{{ page.headline }}</h1>
  {% if page.deck %}<p class="deck">{{ page.deck }}</p>{% endif %}
  {% if page.summary %}
    {% for paragraph in page.summary | split_sep("\n") %}
      {% if paragraph %}<p class="lede">{{ paragraph }}</p>{% endif %}
    {% endfor %}
  {% endif %}
</header>
